{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "glVolition CLI (Debug)",
      "type": "dart",
      "request": "launch",
      "program": "bin/volition.dart",
      "cwd": "${workspaceFolder}",
      "console": "terminal",
      "vmAdditionalArgs": [
        "--enable-asserts"
      ]
    },
    {
      "name": "glVolition CLI (Release)",
      "type": "dart",
      "request": "launch",
      "program": "bin/volition.dart",
      "cwd": "${workspaceFolder}",
      "console": "terminal",
      "noDebug": true
    },
    {
      "name": "glVolition CLI: Doctor (Debug)",
      "type": "dart",
      "request": "launch",
      "program": "bin/volition.dart",
      "args": [
